# Copy to .env for local dev. NEVER commit .env (it holds the secrets master key).
# Only what a local stack needs. Everything else has a working in-code default, or is managed from
# the platform Settings screen once the API is up.

# Postgres. Admin/owner connection, used for DDL and migrations only.
DATABASE_URL=postgres://sre:sre@localhost:45432/sre_platform
# Runtime connection as the non-superuser app role, so every query stays subject to RLS. A
# superuser or BYPASSRLS role voids every tenant policy, and the api and triage-worker refuse to
# boot on one.
APP_DATABASE_URL=postgres://app_user:app@localhost:45432/sre_platform
# Password migrations provision app_user with. Local and test only. An explicit value here is
# always accepted; the weak-default refusal fires only when this key is unset, so a deployed host
# needs a generated password set here.
APP_DB_PASSWORD=app

# Valkey (Streams queue + pub/sub + cache).
VALKEY_URL=redis://localhost:46379

# API server (Hono). Changing PORT means changing VITE_API_BASE_URL and VITE_WS_BASE_URL too, and
# both are pinned in vitest.config.ts and spelled out in the dashboard component tests, so a port
# change is a three-place edit; miss one and the suite breaks.
PORT=43000
# Comma-separated browser-origin allowlist. No wildcard: the API uses credentialed requests and
# exact-origin CSRF checks, so this must match the dashboard's real origin.
CORS_ORIGINS=http://localhost:45173

# Local embeddings (the TEI server from docker-compose). The dimension must match the column the
# migrations create, so changing it needs a schema change.
EMBEDDINGS_URL=http://localhost:4080
EMBEDDINGS_DIM=1024

# Encrypts connector credentials at rest. Generate your own and keep it out of git; a shared or
# committed key would decrypt every stored secret.
# Generate with: openssl rand -base64 32
SECRETS_MASTER_KEY=

# Bootstrap fallback for the investigator. Operators manage the active runtime, provider, model,
# turn cap and credential from /settings, which overrides these once saved. Claude needs exactly
# one of the two credentials below.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Passwordless dev sign-in. Never enable on a shared or deployed host: it grants workspace owner
# and platform operator permissions with no password. Requires all three of NODE_ENV=development,
# which bun run dev sets, zero trusted proxy hops, and a loopback dashboard origin; the last two
# hold on the in-code defaults.
ALLOW_LOCAL_DEVELOPMENT_LOGIN=false
LOCAL_LOGIN_EMAIL=dev@example.test

# Loopback port-forwards to Prometheus and Grafana, supervised by bun run dev. They run unless this
# is exactly false, so the line below keeps them off until you have a reachable cluster; see the
# local development guide for the context and namespace overrides.
DEV_OBSERVABILITY_TUNNELS=false

# Dashboard (Vite). Must point at the API's PORT above and be listed in CORS_ORIGINS.
VITE_API_BASE_URL=http://localhost:43000
# Optional override. When omitted the dashboard derives ws:// or wss:// from VITE_API_BASE_URL.
VITE_WS_BASE_URL=ws://localhost:43000
